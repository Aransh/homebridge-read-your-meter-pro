{
  "name": "homebridge-read-your-meter-pro",
  "displayName": "Read Your Meter Pro",
  "version": "1.0.0",
  "description": "Homebridge plugin exposing Israeli water meter data from the Read Your Meter Pro portal as HomeKit light sensors and leak sensors.",
  "license": "MIT",
  "author": "Aran Shavit",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "water",
    "water-meter",
    "rympro",
    "read-your-meter",
    "arad",
    "israel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aransh/homebridge-read-your-meter-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Aransh/homebridge-read-your-meter-pro/issues"
  },
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc --watch",
    "lint": "eslint . --max-warnings=0",
    "probe": "node scripts/probe.mjs",
    "test": "npm run lint && npm run build && node test/smoke.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.2.2",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "homepage": "https://github.com/Aransh/homebridge-read-your-meter-pro#readme"
}
